<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.5;
      color: #333;
      background-color: #f7fafc;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 20px auto;
      padding: 0 16px;
    }
    .card {
      border-radius: 8px;
      border: 1px solid #ddd;
      background-color: #f9f9f9;
      overflow: hidden;
      margin-bottom: 16px;
    }
    .card-body {
      padding: 20px;
    }
    h1, h2 {
      margin: 0 0 16px;
    }
    h1 {
      font-size: 28px;
      color: #f0ad4e;
      text-align: center;
    }
    h2 {
      font-size: 22px;
      color: #0275d8;
    }
    p {
      margin: 0 0 12px;
    }
    a.button {
      display: inline-block;
      padding: 10px 20px;
      margin: 12px 0;
      font-size: 14px;
      color: #fff;
      background-color: #0275d8;
      text-decoration: none;
      border-radius: 4px;
    }
    dl.details {
      margin-top: 10px;
      padding: 10px;
      background-color: #fff;
      border: 1px solid #ddd;
      border-radius: 4px;
    }
    dl.details dt {
      font-weight: bold;
    }
    dl.details dd {
      margin: 0 0 10px 0;
    }
    hr {
      border: 0;
      border-top: 1px solid #ddd;
      margin: 16px 0;
    }
    .footer {
      font-size: 12px;
      text-align: center;
      color: #6c757d;
      padding: 16px 0;
    }
  </style>
</head>
<body>

  <div class="container">

    <!-- Header Card -->
    <div class="card">
      <div class="card-body">
        <h1>Security Report</h1>
        <p>Hello! Below is what SecretKeeper has discovered during the last scan.</p>
      </div>
    </div>

    <!-- Notifications -->
    {% for title, notification in notifications.items() %}
    <div class="card">
      <div class="card-body">
        <h2>{{ title }}</h2>
        <a href="{{ notification.url }}" class="button">Link to repository</a>

        {% for notif in notification.notifications %}
          <dl class="details">
            {% if notif.leak != None %}
              <dt>Leak Found:</dt>
              <dd>Type: {{ notif.leak.rule }}</dd>
              <dd>File: {{ notif.leak.file }}</dd>
              {% if notif.leak.date != None %}
                <dd>Leak Date: {{ notif.leak.date.strftime('%d-%m-%Y') }}</dd>
              {% endif %}
              <dd><a href="{{ notif.leak.leakURL }}" class="button">Go to leak</a></dd>
            {% else %}
              <dd>{{ notif.content }}</dd>
              {% if notif.repository != None %}
                <dd><a href="{{ notif.repository.url_http | replace('.git','') }}/permissions" class="button">Repository Permissions</a></dd>
              {% elif notif.project != None %}
                <dd><a href="{{ notif.project.url | replace('.git','') }}/permissions" class="button">Project Permissions</a></dd>
              {% endif %}
            {% endif %}
          </dl>
          <hr/>
        {% endfor %}

      </div>
    </div>
    {% endfor %}

    <div class="footer">This is an automated report.</div>

  </div>

</body>
</html>
